# Python
*__pycache__*
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env

# 模型权重与训练输出（体积大，勿提交）
*.pt
*.pth
*.ckpt
*.onnx
checkpoints/pretrained/
exp/
**/exp/

# 评测运行日志（可本地重跑脚本再生）
*.log
checkpoints/eval_*_logs/
checkpoints/**/nohup*.out
checkpoints/**/master.log

# 数据与键值库（本机路径，不进仓库）
*.mdb
*.lmdb
/data/

# 编辑器与系统杂项
.DS_Store
.idea/
.vscode/
*.swp
*~

# 临时文件
/tmp/
*.tmp
*.bak

# 本机审查、隔离依赖和原始运行证据；只提交可复现工具与精简中文结论。
.audit-local/
.venv-*/
/runs/
/outputs/
/reports/raw/

# 原声、视频及概率/张量原件不能随维护代码进入公开仓库。
*.wav
*.flac
*.mp3
*.aac
*.m4a
*.ogg
*.mp4
*.webm
*.npy
*.npz
