# =============================================================================
# LM（大间隔微调）启动环境模板 —— 复制到私有审计目录后按实际情况改
# =============================================================================
# 用法：
#   set -a; . /受控目录/lm.env; set +a
#   bash tools/ptn_resume/lm_launch/run_lm.sh
#
# 这里每个值都对应 docs/12 §3/§4/§5 已核实的结论，不要凭印象改。
# =============================================================================

# 训练表与增强数据的根。容器里必须同时能读到 /root/group-shared/... 与
# /shared/group-shared/... 两个前缀（现有 data.list 两种都写）。
DATA_ROOT=/root/group-shared/voiceprint/data/wespeaker_data

# ---- 存储位置（2026-11-09 新规） --------------------------------------------
# 大数据（run、权重、日志）默认只写共享盘
#   /root/group-shared/voiceprint/experiments/redimnet2/<实验名>/
# 下面 PTN_EXP_DIR / MODEL_CKPT 的值是已经跑完的第三段（历史盘上的既有产物），
# 只作只读输入保留，不是新的写出位置。旧默认 LM 输出目录
# （历史盘 .../lm-from-ptn115-20261106-v1/lm）属于历史路径。
# 常量同 tools/ptn_resume/storage_policy.py。

# 第三段（48—120）的实际输出目录。spk2id.json 在这一层，模型在同层 models/。
# 历史路径，只读输入。
PTN_EXP_DIR=/root/experiments/redimnet2/b6-mix-official-20261019/ptn-resume-model47-capture-20261026-v1/ptn  # storage-policy-allow: 已完成第三段 run 的只读权重/映射来源

# LM 的新输出目录：提交前必须不存在；失败后换 -v2，不覆盖、不改名。
# 换实验名时改最后两段；run_lm.sh 缺省是 .../redimnet2/lm-from-ptn115/lm。
EXP_DIR=/root/group-shared/voiceprint/experiments/redimnet2/lm-from-ptn115/lm

# 显式指定第 115 轮。绝对不要留空：脚本缺省会按 mtime 取最新，那是 model_120.pt。
# 历史路径，只读输入。
MODEL_CKPT=/root/experiments/redimnet2/b6-mix-official-20261019/ptn-resume-model47-capture-20261026-v1/ptn/models/model_115.pt  # storage-policy-allow: 已完成第三段 run 的只读权重来源

# 与 PTN 段同一个解释器（第三段 launch.log 里就是它）。
PYTHON_BIN=/root/miniforge3/envs/redimnet2/bin/python

# 单机八卡。
NUM_GPUS=8

# ---- 以下由 run_lm.sh 内部固定，禁止外部设置（设了会被拒绝） ---------------
# STAGE=lm              run_lm.sh 自己导出
# REPRO=1               选中 official_repro_lm.yaml
# NUM_EPOCHS=1          来自配方
# BATCH_SIZE=48         每卡，来自配方；8 卡 = 384/步
# SAMPLE_NUM_PER_EPOCH  不设（配方为 0，表示用全表）
# SKIP_*=0              八项检查一律不许跳过
#
# ---- 配方里已固定的关键值（改配方就是改实验，不要用环境变量绕） -----------
# 每轮步数            5,021,010 / 384 = 13,075
# num_frms            500（PTN 是 200）
# speed_perturb       false
# 增强根概率          0.7（PTN 是 0.9）
# do_lm               true，SphereFace2 t=3，类别 115,362
# margin              恒 0.3（PTN 末段是 0.2）
# 学习率              ExponentialDecrease，warm_up 0.2 轮，倍率 8*48/64=6
#                     峰值 4.5471497e-4 @ 第 2,615 步；末步 1.5001590e-4
# weight_decay        4.0e-5
# 优化器 / scaler     冷启动：只载模型参数，SGD 动量与 GradScaler 全新
# 自动重试            必须关闭（否则会在同一目录二次冷启动）
