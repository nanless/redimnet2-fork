+    inode/bytes/mtime_ns/ctime_ns 逐项严格相等，任一不同即拒；device 不同只记为
+    device_relaxed=True 并留日志。返回是否发生了 device 漂移。
+    """
+    need(isinstance(recorded, dict), 'recorded stat identity missing')
+    for key in ('inode', 'bytes', 'mtime_ns', 'ctime_ns'):
+        need(now.get(key) == recorded.get(key), 'source changed since sidecar publication: ' + key)
+    return now.get('device') != recorded.get('device')
+
